# makefile for GNU make (automatically generated by makemake)
# NOTE: indent with TAB in GNU makefiles!

# paths are relative to the project directory (current directory during make)

APP    = MultiRename
EXE    = $(APP)_sas
OBJDIR = build-sas/

# compiler and linker

CC = sc:c/sc
LD = sc:c/sc

# target 'all' (default target)

all : $(EXE)

$(OBJDIR)application.o : src/application.c
	$(CC) nolink src/application.c

$(OBJDIR)date_tools.o : src/date_tools.c
	$(CC) nolink src/date_tools.c

$(OBJDIR)file_tools.o : src/file_tools.c
	$(CC) nolink src/file_tools.c

$(OBJDIR)file_nodes.o : src/file_nodes.c
	$(CC) nolink src/file_nodes.c

$(OBJDIR)menu_tools.o : src/menu_tools.c
	$(CC) nolink src/menu_tools.c

$(OBJDIR)main.o : src/main.c
	$(CC) nolink src/main.c

$(OBJDIR)notifications.o : src/notifications.c
	$(CC) nolink src/notifications.c

$(OBJDIR)parsed_args.o : src/parsed_args.c
	$(CC) nolink src/parsed_args.c

$(OBJDIR)range_mask.o : src/range_mask.c
	$(CC) nolink src/range_mask.c

$(OBJDIR)range_select_window.o : src/range_select_window.c
	$(CC) nolink src/range_select_window.c

$(OBJDIR)rename_algorithm.o : src/rename_algorithm.c
	$(CC) nolink src/rename_algorithm.c

$(OBJDIR)rename_counter.o : src/rename_counter.c
	$(CC) nolink src/rename_counter.c

$(OBJDIR)rename_parser.o : src/rename_parser.c
	$(CC) nolink src/rename_parser.c

$(OBJDIR)rename.o : src/rename.c
	$(CC) nolink src/rename.c

$(OBJDIR)requester.o : src/requester.c
	$(CC) nolink src/requester.c

$(OBJDIR)string_tools.o : src/string_tools.c
	$(CC) nolink src/string_tools.c

$(OBJDIR)localization.o : src/localization.c
	$(CC) nolink src/localization.c

$(OBJDIR)ui_tools.o : src/ui_tools.c
	$(CC) nolink src/ui_tools.c

OBJS = $(OBJDIR)application.o $(OBJDIR)date_tools.o $(OBJDIR)file_nodes.o
OBJS = $(OBJS) $(OBJDIR)file_tools.o $(OBJDIR)localization.o
OBJS = $(OBJS) $(OBJDIR)menu_tools.o $(OBJDIR)main.o $(OBJDIR)notifications.o
OBJS = $(OBJS) $(OBJDIR)parsed_args.o $(OBJDIR)range_mask.o
OBJS = $(OBJS) $(OBJDIR)range_select_window.o $(OBJDIR)rename_algorithm.o
OBJS = $(OBJS) $(OBJDIR)rename_counter.o $(OBJDIR)rename_parser.o
OBJS = $(OBJS) $(OBJDIR)rename.o $(OBJDIR)requester.o $(OBJDIR)string_tools.o
OBJS = $(OBJS) $(OBJDIR)ui_tools.o

$(EXE) : $(OBJS)
	$(LD) link $(OBJS)

# target translations

translations: CatComp/$(APP).cd
	CatComp CatComp/$(APP).cd CTFILE CatComp/$(APP)_de.ct
	CatComp CatComp/$(APP).cd CTFILE CatComp/$(APP)_fr.ct

# target catalog-header
# NOTE: After this, manually delete the `struct LocaleInfo` declaration
#       in multirename_catalog.h
# REASON: I needed to have 'an own' definition of `struct LocaleInfo`
#					in `localization.h` to avoid an circular include issue.
catalog-header: CatComp/$(APP).cd
	CatComp CatComp/$(APP).cd CFILE src/$(APP)_catalog.h NOARRAY NOCODE


# target catalogs

catalogs: CatComp/$(APP).cd CatComp/$(APP)_de.ct CatComp/$(APP)_fr.ct
  -Makedir Catalogs
  CatComp CatComp/$(APP).cd CatComp/$(APP)_de.ct CATALOG $(APP)_de.catalog
  -Makedir catalogs/deutsch
  -Copy $(APP)_de.catalog Catalogs/deutsch/$(APP).catalog FORCE
  -Delete $(APP)_de.catalog
  CatComp CatComp/$(APP).cd CatComp/$(APP)_fr.ct CATALOG $(APP)_fr.catalog
  -Makedir catalogs/français
  -Copy $(APP)_fr.catalog Catalogs/français/$(APP).catalog FORCE
  -Delete $(APP)_fr.catalog

# target 'clean'

clean:
	-delete $(EXE)
	-delete $(EXE).info
	-delete $(EXE).lnk
	-delete $(OBJDIR)\#?.o
