# makefile for GNU make (automatically generated by makemake)
# NOTE: indent with TAB in GNU makefiles!

# paths are relative to the project directory (current directory during make)

EXE    = MultiRename_sas
OBJDIR = build-sas/

# compiler and linker

CC = sc:c/sc
LD = sc:c/sc

# target 'all' (default target)

all : $(EXE)

$(OBJDIR)application.o : src/application.c
	$(CC) nolink src/application.c

$(OBJDIR)date_tools.o : src/date_tools.c
	$(CC) nolink src/date_tools.c

$(OBJDIR)file_tools.o : src/file_tools.c
	$(CC) nolink src/file_tools.c

$(OBJDIR)file_nodes.o : src/file_nodes.c
	$(CC) nolink src/file_nodes.c

$(OBJDIR)menu_tools.o : src/menu_tools.c
	$(CC) nolink src/menu_tools.c

$(OBJDIR)main.o : src/main.c
	$(CC) nolink src/main.c

$(OBJDIR)notifications.o : src/notifications.c
	$(CC) nolink src/notifications.c

$(OBJDIR)parsed_args.o : src/parsed_args.c
	$(CC) nolink src/parsed_args.c

$(OBJDIR)range_mask.o : src/range_mask.c
	$(CC) nolink src/range_mask.c

$(OBJDIR)range_select_window.o : src/range_select_window.c
	$(CC) nolink src/range_select_window.c

$(OBJDIR)rename_algorithm.o : src/rename_algorithm.c
	$(CC) nolink src/rename_algorithm.c

$(OBJDIR)rename_counter.o : src/rename_counter.c
	$(CC) nolink src/rename_counter.c

$(OBJDIR)rename_parser.o : src/rename_parser.c
	$(CC) nolink src/rename_parser.c

$(OBJDIR)rename.o : src/rename.c
	$(CC) nolink src/rename.c

$(OBJDIR)requester.o : src/requester.c
	$(CC) nolink src/requester.c

$(OBJDIR)string_tools.o : src/string_tools.c
	$(CC) nolink src/string_tools.c

$(OBJDIR)translation.o : src/translation.c
	$(CC) nolink src/translation.c

$(OBJDIR)ui_tools.o : src/ui_tools.c
	$(CC) nolink src/ui_tools.c

OBJS = $(OBJDIR)application.o $(OBJDIR)date_tools.o $(OBJDIR)file_nodes.o
OBJS = $(OBJS) $(OBJDIR)file_tools.o $(OBJDIR)menu_tools.o $(OBJDIR)main.o
OBJS = $(OBJS) $(OBJDIR)notifications.o $(OBJDIR)parsed_args.o
OBJS = $(OBJS) $(OBJDIR)range_mask.o $(OBJDIR)range_select_window.o
OBJS = $(OBJS) $(OBJDIR)rename_algorithm.o $(OBJDIR)rename_counter.o
OBJS = $(OBJS) $(OBJDIR)rename_parser.o $(OBJDIR)rename.o
OBJS = $(OBJS) $(OBJDIR)requester.o $(OBJDIR)string_tools.o
OBJS = $(OBJS) $(OBJDIR)translation.o $(OBJDIR)ui_tools.o

$(EXE) : $(OBJS)
	$(LD) link $(OBJS)


# target localize PATCH
# NOTE: Manually do step 1 before:
#  	Create the localize_file by running
# 		'localize *.c > localize_file'
#	and then edit it by
#	1) Only keep the lines that should be translated
#   2) Change the string
localize:
	localize localize_file PATCH TEMPLATE "tr(pApp->pLocaleInfo, %I)"


# target translations

translations: CatComp/$(EXE).cd
	CatComp CatComp/$(EXE).cd CTFILE CatComp/$(EXE)_de.ct
	CatComp CatComp/$(EXE).cd CTFILE CatComp/$(EXE)_es.ct
	CatComp CatComp/$(EXE).cd CTFILE CatComp/$(EXE)_fr.ct

# target catalog-header
catalog-header: CatComp/$(EXE).cd
	CatComp CatComp/$(EXE).cd CFILE src/$(EXE)_catalog.h NOARRAY NOCODE


# target catalogs

catalogs: CatComp/$(EXE).cd CatComp/$(EXE)_de.ct CatComp/$(EXE)_es.ct CatComp/$(EXE)_fr.ct
  -Makedir Catalogs
  CatComp CatComp/$(EXE).cd CatComp/$(EXE)_de.ct CATALOG $(EXE)_de.catalog
  -Makedir catalogs/deutsch
  -Copy $(EXE)_de.catalog Catalogs/deutsch/$(EXE).catalog FORCE
  -Delete $(EXE)_de.catalog
  CatComp CatComp/$(EXE).cd CatComp/$(EXE)_fr.ct CATALOG $(EXE)_fr.catalog
  -Makedir catalogs/français
  -Copy $(EXE)_fr.catalog Catalogs/français/$(EXE).catalog FORCE
  -Delete $(EXE)_fr.catalog

# target 'clean'

clean:
	-delete $(EXE)
	-delete $(EXE).info
	-delete $(EXE).lnk
	-delete $(OBJDIR)\*.o
