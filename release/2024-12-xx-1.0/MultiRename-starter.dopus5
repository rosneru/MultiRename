/* $VER: MultiRename-starter.dopus5 1.0 (08.06.25)
 *
 * Concatenates the names of all selected files from source lister and
 * opens them with the tool MultiRename, omitting the 512 byte command
 * line length limit of DOpus 5.82 and allows MultiRename to be started
 * with all selected files.
 *
 * It needs two parameters:
 *   1. the DOpus port (the {Qp} template in DOpus)
 *   2. the DOpus public screen name (the {Qs} template in DOpus)
 *
 * So, in my setup the ARexx field for the MultiRename button goes like this:
 *   DOpus5:ARexx/MultiRename-starter.dopus5 {Qp} {Qs}
 *
 * From the flags below the ARexx field select only:
 *  - Output to window
 *  - Rescan source
 *
 * and leave the others
 *  - CD destination
 *  - CD source
 *  - Do all files
 *  - No file quote
 *  - Output to reader
 *  - Recursive dirs
 *  - Reload each file
 *  - Resan dest
 *  - Run asynchronously
 *  - Window close button
 *  - Window on Workbench
 * Unchecked.
 *
 * Uwe Rosner, 07.06.2025
 */

multi_rename_location = 'SYS:Tools/MultiRename'
multi_rename_args = 'LONGNAMES PUBSCREEN DOPUS.1 '

options results
options failat 99
signal on syntax;signal on ioerr

parse arg dopus_port dopus_screen
dopus_port = Strip(dopus_port, "B", '" ')

if ~Show("P", dopus_port) then do
  say dopus_port "is not a valid port."
  exit
end

address value dopus_port

'DOPUS VERSION'
if ( result='RESULT' | Translate(result, '.', ' ') < 5.1218 ) then do
  dopus request '"This script requires Dopus v5.5 or later." Ok'
  exit
end

'LISTER QUERY SOURCE STEM' src_handle
if src_handle.count = 0 then do
  dopus request '"You must have a source lister" OK'
  exit
end

'LISTER QUERY' src_handle.0 'PATH'
files_path = result
if length(files_path) = 0 then do
  dopus request '"Got no path for source lister" OK'
  exit
end

'LISTER QUERY' src_handle.0 'SELENTRIES STEM' src_selected_files
if src_selected_files.count = 0 then do
  dopus request '"No files selected in source lister" OK'
  exit
end


files = ''
max_idx = src_selected_files.count - 1
do i = 0 to max_idx
  files = files'"'src_selected_files.i'" '
end

/*
cmd = multi_rename_location files multi_rename_args
dopus request cmd
*/

Address Command multi_rename_location files multi_rename_args

syntax:;ioerr:                          /* In case of error, jump here */
EXIT

